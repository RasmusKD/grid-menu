{
  "schemaVersion": 1,
  "id": "gridmenu",
  "version": "${version}",
  "name": "Grid Menu",
  "description": "Replaces the Mod Menu mods list with a compact grid of tiles.",
  "authors": [
    "DC: rasmuskd, MC: WhoToldYou"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.rasmus.gridmenu.GridMenuClient"
    ],
    "modmenu": [
      "com.rasmus.gridmenu.config.GridMenuModMenuIntegration"
    ]
  },
  "mixins": [
    "gridmenu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "${mc_range}",
    "cloth-config2": ">=26.1.0",
    "modmenu": "${modmenu_range}",
    "java": ">=25"
  },
  "icon": "assets/gridmenu/icon.png"
}
